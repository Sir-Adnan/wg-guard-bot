# ===========================================================================
#  WG-Guard Bot — example configuration file
#  Copy this file to .env and fill in the values.
#  install.sh does this for you automatically.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) Core settings
# ---------------------------------------------------------------------------
# Display name of the bot / shop
APP_NAME="فروشگاه VPN"
# production or development
ENV=production
DEBUG=false
# Timezone used for reports and Jalali dates
TIMEZONE=Asia/Tehran
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# Security key (64 hex characters). Generated automatically by install.sh.
# The same key signs the panel cookie and encrypts sensitive values.
# Never change it unless you intend to rebuild everything from scratch.
SECRET_KEY=

# ---------------------------------------------------------------------------
# 2) Telegram
# ---------------------------------------------------------------------------
# Bot token from @BotFather
BOT_TOKEN=
# polling (recommended, no domain needed) or webhook
BOT_MODE=polling
# Required in webhook mode only, e.g. https://bot.example.com
WEBHOOK_BASE_URL=
# Secret webhook path; generated automatically by install.sh
WEBHOOK_SECRET=
# Local Bot API server address (optional) — e.g. http://localhost:8081
BOT_API_SERVER=
# Proxy for reaching Telegram (optional) — e.g. socks5://127.0.0.1:1080
BOT_PROXY=

# ---------------------------------------------------------------------------
# 3) Database
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=wgguard
POSTGRES_USER=wgguard
POSTGRES_PASSWORD=
# Fill this in to use an external database (the settings below are then ignored)
# Example: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------------
# 4) Redis (conversation state, locks and cache)
# ---------------------------------------------------------------------------
# Without Redis the bot falls back to in-memory storage automatically.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# 5) Web admin panel
# ---------------------------------------------------------------------------
PANEL_ENABLED=true
PANEL_HOST=0.0.0.0
PANEL_PORT=8080
# Public panel URL (used for absolute links and HTTPS detection)
PANEL_BASE_URL=http://localhost:8080
# Set to true behind a reverse proxy (honours X-Forwarded-*)
PANEL_BEHIND_PROXY=false
# Panel owner username and password — generated automatically by install.sh
OWNER_USERNAME=admin
OWNER_PASSWORD=
# Numeric Telegram IDs of the main admins (comma separated) — full access
ADMIN_IDS=
# Numeric Telegram IDs of support agents (comma separated) — limited access
SUPPORT_IDS=

# ---------------------------------------------------------------------------
# 5.1) Domain and automatic SSL (Caddy)
# ---------------------------------------------------------------------------
# Domain or subdomain, without https — e.g. bot.example.com
# Leave empty to run the bot without a domain, in polling mode.
DOMAIN=
# Email for Let's Encrypt (optional, but recommended)
# If it stays empty the certificate is still issued, but no expiry warning arrives;
# a placeholder address (admin@<domain>) is used only to keep the Caddy config valid.
ACME_EMAIL=
# Panel bind address on the host; with a domain use 127.0.0.1 so only Caddy reaches it
PANEL_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# 6) Shop and payment
# ---------------------------------------------------------------------------
# Amounts are always stored in Rial (by design).
# This option only controls how amounts are displayed: toman or rial
CURRENCY_DISPLAY=toman
# Card-to-card payment
CARD_TO_CARD_ENABLED=true
# Customer wallets
WALLET_ENABLED=true
# Test service
TEST_SERVICE_ENABLED=true
# Allowed gap between two test services (days)
TEST_SERVICE_COOLDOWN_DAYS=30
# Receipt deadline after an order is created (minutes)
RECEIPT_EXPIRE_MINUTES=90
# Default subscription-link base URL (when the panel has its own public address)
SUBSCRIPTION_BASE_URL=
# Minimum wallet top-up (Rial) — 50,000 Toman
MIN_DEPOSIT_RIAL=500000
# Referral reward percentage (0 = disabled)
REFERRAL_PERCENT=0

# ---------------------------------------------------------------------------
# 7) Backups
# ---------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ---------------------------------------------------------------------------
# 8) Advanced
# ---------------------------------------------------------------------------
# Maximum concurrent requests to the WG-Guard panels
WG_REQUEST_TIMEOUT=30
WG_CONNECT_TIMEOUT=10
WG_MAX_RETRIES=3
# Panel health-check interval (seconds)
PANEL_HEALTH_INTERVAL=300
# Maximum receipt file size (megabytes)
RECEIPT_MAX_FILE_MB=8
