# ===========================================================================
#  WG-Guard Bot — نمونه فایل تنظیمات
#  این فایل را به .env کپی کنید و مقادیر را پر کنید.
#  اسکریپت install.sh این کار را به صورت خودکار انجام می‌دهد.
# ===========================================================================

# ---------------------------------------------------------------------------
# ۱) تنظیمات پایه
# ---------------------------------------------------------------------------
# نام نمایشی ربات/فروشگاه
APP_NAME="فروشگاه VPN"
# production یا development
ENV=production
DEBUG=false
# منطقه زمانی برای گزارش‌ها و تاریخ شمسی
TIMEZONE=Asia/Tehran
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO

# کلید امنیتی (۶۴ کاراکتر هگز). با install.sh خودکار ساخته می‌شود.
# از همین کلید برای امضای کوکی پنل و رمزنگاری اطلاعات حساس استفاده می‌شود.
# هرگز آن را تغییر ندهید مگر اینکه بخواهید همه‌چیز را از نو بسازید.
SECRET_KEY=

# ---------------------------------------------------------------------------
# ۲) تلگرام
# ---------------------------------------------------------------------------
# توکن ربات از @BotFather
BOT_TOKEN=
# polling (پیشنهادی، بدون نیاز به دامنه) یا webhook
BOT_MODE=polling
# فقط در حالت webhook لازم است، مثال: https://bot.example.com
WEBHOOK_BASE_URL=
# مسیر مخفی وب‌هوک؛ با install.sh خودکار ساخته می‌شود
WEBHOOK_SECRET=
# آدرس سرور محلی Bot API (اختیاری) — مثال: http://localhost:8081
BOT_API_SERVER=
# پروکسی برای ارتباط با تلگرام (اختیاری) — مثال: socks5://127.0.0.1:1080
BOT_PROXY=

# ---------------------------------------------------------------------------
# ۳) دیتابیس
# ---------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=wgguard
POSTGRES_USER=wgguard
POSTGRES_PASSWORD=
# اگر می‌خواهید به دیتابیس بیرونی وصل شوید، این را پر کنید (بقیه نادیده گرفته می‌شود)
# مثال: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------------
# ۴) Redis (برای وضعیت گفتگو، قفل‌ها و کش)
# ---------------------------------------------------------------------------
# اگر Redis در دسترس نباشد، ربات به‌صورت خودکار از حافظه موقت استفاده می‌کند.
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# ۵) پنل مدیریت وب
# ---------------------------------------------------------------------------
PANEL_ENABLED=true
PANEL_HOST=0.0.0.0
PANEL_PORT=8080
# آدرس عمومی پنل (برای ساخت لینک‌های مطلق و تشخیص HTTPS)
PANEL_BASE_URL=http://localhost:8080
# اگر پشت پروکسی معکوس هستید، این را true کنید (احترام به X-Forwarded-*)
PANEL_BEHIND_PROXY=false
# کاربر و رمز مالک پنل — با install.sh خودکار ساخته می‌شود
OWNER_USERNAME=admin
OWNER_PASSWORD=
# شناسه عددی تلگرام مدیران اصلی (با کاما جدا کنید) — دسترسی کامل
ADMIN_IDS=
# شناسه عددی تلگرام پشتیبان‌ها (با کاما جدا کنید) — دسترسی محدود
SUPPORT_IDS=

# ---------------------------------------------------------------------------
# ۵.۱) دامنه و گواهی SSL خودکار (Caddy)
# ---------------------------------------------------------------------------
# دامنه یا زیردامنه (بدون https) — مثال: bot.example.com
# خالی بگذارید تا ربات بدون دامنه و در حالت polling اجرا شود.
DOMAIN=
# ایمیل برای Let's Encrypt (اختیاری ولی پیشنهاد می‌شود)
# اگر خالی بماند، گواهی صادر می‌شود اما ایمیل هشدار نزدیک‌شدن انقضا نمی‌آید؛
# در این حالت یک آدرس جانشین (admin@<دامنه>) فقط برای معتبرماندن تنظیمات Caddy استفاده می‌شود.
ACME_EMAIL=
# آدرس اتصال پنل روی هاست؛ با دامنه، 127.0.0.1 بگذارید تا فقط از بیرون از طریق Caddy در دسترس باشد
PANEL_BIND=0.0.0.0

# ---------------------------------------------------------------------------
# ۶) فروشگاه و پرداخت
# ---------------------------------------------------------------------------
# واحد پایه ذخیره‌سازی همیشه ریال است (طبق دستور کار).
# این گزینه فقط نحوه «نمایش» را تعیین می‌کند: toman یا rial
CURRENCY_DISPLAY=toman
# پرداخت کارت به کارت
CARD_TO_CARD_ENABLED=true
# کیف پول کاربران
WALLET_ENABLED=true
# سرویس تست
TEST_SERVICE_ENABLED=true
# فاصله مجاز بین دو سرویس تست (روز)
TEST_SERVICE_COOLDOWN_DAYS=30
# مهلت ارسال رسید پس از ساخت سفارش (دقیقه)
RECEIPT_EXPIRE_MINUTES=90
# آدرس پیش‌فرض لینک اشتراک (اگر پنل آدرس عمومی جداگانه‌ای دارد)
SUBSCRIPTION_BASE_URL=
# حداقل مبلغ شارژ کیف پول (ریال) — ۵۰٬۰۰۰ تومان
MIN_DEPOSIT_RIAL=500000
# درصد پاداش معرفی دوستان (۰ = غیرفعال)
REFERRAL_PERCENT=0

# ---------------------------------------------------------------------------
# ۷) پشتیبان‌گیری
# ---------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ---------------------------------------------------------------------------
# ۸) پیشرفته
# ---------------------------------------------------------------------------
# حداکثر تعداد درخواست هم‌زمان به پنل‌های WG-Guard
WG_REQUEST_TIMEOUT=30
WG_CONNECT_TIMEOUT=10
WG_MAX_RETRIES=3
# فاصله بررسی سلامت پنل‌ها (ثانیه)
PANEL_HEALTH_INTERVAL=300
# حداکثر حجم فایل رسید (مگابایت)
RECEIPT_MAX_FILE_MB=8
