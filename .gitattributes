# Line-ending policy.
#
# Shell scripts MUST stay LF: they are executed on Linux, and a CRLF shebang
# makes them fail with `bad interpreter: /usr/bin/env bash^M`.  This matters on
# a Windows checkout, which is where most of this project was authored.
* text=auto

*.sh            text eol=lf
Caddyfile       text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Makefile        text eol=lf

*.py            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.ini           text eol=lf
*.toml          text eol=lf
.env.example    text eol=lf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary

# Keep diffs readable and stop GitHub from collapsing generated files.
alembic/versions/*.py linguist-generated=false
